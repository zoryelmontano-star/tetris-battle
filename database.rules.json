{
  "rules": {
    ".read": false,
    ".write": false,
    "matchmaking": {
      ".read": "auth !== null",
      ".write": "auth !== null"
    },
    "sessions": {
      "$room": {
        ".read": "auth !== null",
        "meta": {
          ".write": "auth !== null"
        },
        "players": {
          ".write": "auth !== null"
        },
        "events": {
          "$event": {
            ".write": "auth !== null",
            ".validate": "newData.hasChildren(['type','playerId','ts'])"
          }
        }
      }
    }
  }
}
